{
  "paths": {
    "video_dir": "./input",
    "output_dir": "./output"
  },
  "asr": {
    "backend": "sensevoice",
    "model_dir": "./models/sensevoice",
    "vad_model": "./models/vad/silero_vad.onnx",
    "threads": 2,
    "max_speech_seconds": 20.0
  },
  "llm": {
    "base_url": "https://api.moonshot.cn/v1",
    "model": "kimi-k3",
    "api_key_env": "MOONSHOT_API_KEY",
    "temperature": 0.3,
    "max_tokens": 30000,
    "max_retries": 1
  },
  "notes": {
    "rules_file": "./config/note_rules.md",
    "schedule_file": "./config/schedule.json",
    "min_length": 1500,
    "max_length": 20000
  },
  "render": {
    "enabled": true
  },
  "notify": {
    "enabled": false,
    "webhook_env": "WECOM_WEBHOOK"
  },
  "retention": {
    "days": 1
  }
}
